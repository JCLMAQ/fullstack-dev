{
  "name": "frontend/app-jcm",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/frontend/app-jcm/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/frontend/app-jcm",
        "browser": "apps/frontend/app-jcm/src/main.ts",
        "polyfills": [],
        "tsConfig": "apps/frontend/app-jcm/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/frontend/app-jcm/public"
          }
        ],
        "styles": [
          "apps/frontend/app-jcm/src/styles.scss",
          "node_modules/material-icons/iconfont/material-icons.css",
          "node_modules/material-symbols/index.css",
          "node_modules/roboto-fontface/css/roboto/roboto-fontface.css",
          "node_modules/flag-icons/css/flag-icons.min.css"
        ],
        "allowedCommonJsDependencies": [
          "google-libphonenumber",
          "lodash.throttle"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1700kb",
              "maximumError": "2000kb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "30kb",
              "maximumError": "40kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "outputHashing": "media"
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4000,
        "proxyConfig": "proxy.config.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "frontend/app-jcm:build:production"
        },
        "development": {
          "buildTarget": "frontend/app-jcm:build:development"
        }
      },
      "readyWhen": {
        "signal": true
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "frontend/app-jcm:build"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": [
            "eslint"
          ]
        }
      ]
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "readyWhen": {
        "signal": true
      },
      "dependsOn": [
        "build"
      ],
      "options": {
        "buildTarget": "frontend/app-jcm:build",
        "port": 4000,
        "staticFilePath": "dist/apps/frontend/app-jcm/browser",
        "spa": true
      }
    }
  }
}