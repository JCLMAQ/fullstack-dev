{
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#fbed80",
        "activityBar.background": "#fbed80",
        "activityBar.foreground": "#15202b",
        "activityBar.inactiveForeground": "#15202b99",
        "activityBarBadge.background": "#06b9a5",
        "activityBarBadge.foreground": "#15202b",
        "commandCenter.border": "#15202b99",
        "sash.hoverBorder": "#fbed80",
        "statusBar.background": "#f9e64f",
        "statusBar.foreground": "#15202b",
        "statusBarItem.hoverBackground": "#f7df1e",
        "statusBarItem.remoteBackground": "#f9e64f",
        "statusBarItem.remoteForeground": "#15202b",
        "titleBar.activeBackground": "#f9e64f",
        "titleBar.activeForeground": "#15202b",
        "titleBar.inactiveBackground": "#f9e64f99",
        "titleBar.inactiveForeground": "#15202b99"
    },
    "peacock.color": "#f9e64f",
    "postman.settings.dotenv-detection-notification-visibility": false,
    "i18n-ally.localesPaths": [
        "apps/frontend/app-jcm/public/i18n",
        "libs/frontend/shared/components/messages",
        "apps/backend/nest-app/src/assets/i18n",
        "libs/frontend/core/services/src/lib/messages",
        "libs/frontend/shared/components/messages/src/lib/messages"
    ],
    "i18n-ally.keystyle": "nested",
    "jest.enable": false,
    "chat.promptFilesRecommendations": {
        "speckit.constitution": true,
        "speckit.specify": true,
        "speckit.plan": true,
        "speckit.tasks": true,
        "speckit.implement": true
    },
    "chat.tools.terminal.autoApprove": {
        ".specify/scripts/bash/": true,
        ".specify/scripts/powershell/": true
    },
    "window.autoDetectColorScheme": false,
    "workbench.colorTheme": "Dark Modern",
    "workbench.browser.openLocalhostLinks": true,
    "chat.mcp.serverSampling": {
        "fullstack-dev/.vscode/mcp.json: chrome-devtools": {
            "allowedModels": [
                "copilot/claude-sonnet-4.5",
                "copilot/gemini-2.5-pro",
                "copilot/gemini-3-pro-preview",
                "copilot/gpt-5.2-codex",
                "copilot/oswe-vscode-prime"
            ]
        },
        "fullstack-dev/.vscode/mcp.json: deepcontext": {
            "allowedModels": [
                "copilot/auto"
            ]
        }
    },
    "chat.agentSkillsLocations": {
        ".opencode/skills": true,
        ".windsurf/skills": true,
        ".gemini/skills": true
    },
    "chat.experimental.useSkillAdherencePrompt": true
}
